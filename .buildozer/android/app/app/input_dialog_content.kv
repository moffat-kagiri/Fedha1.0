#:import get_color kivy.utils.get_color_from_hex
#:import MDTextField kivymd.uix.textfield.MDTextField

<InputDialogContent>:
    orientation: "vertical"
    spacing: "12dp"
    padding: "20dp"
    size_hint_y: None
    height: self.minimum_height

    BoxLayout:
        size_hint_y: None
        height: "10dp"

    MDTextField:
        id: description_input
        hint_text: root.hint_text
        font_size: "16sp"
        mode: "fill"
        fill_color: get_color("#2D2D2D")
        line_color_normal: get_color("#4D4D4D")
        line_color_focus: get_color("#2196F3")
        multiline: False
        size_hint_y: None
        height: "48dp"

    MDTextField:
        id: amount_input
        hint_text: "Amount (KES)" 
        input_filter: "float"
        font_size: "16sp"
        mode: "fill"
        fill_color: get_color("#2D2D2D")
        line_color_normal: get_color("#4D4D4D")
        line_color_focus: get_color("#2196F3")
        multiline: False
        size_hint_y: None
        height: "48dp"
        on_text: root.calculate_apr_if_ready()

    MDTextField:
        id: term_input
        hint_text: "Term (months)"
        input_filter: "int"
        font_size: "16sp"
        mode: "fill"
        fill_color: get_color("#2D2D2D")
        line_color_normal: get_color("#4D4D4D")
        line_color_focus: get_color("#2196F3")
        multiline: False
        size_hint_y: None
        height: "48dp"
        opacity: 0
        disabled: True
        on_text: root.calculate_apr_if_ready()

    MDTextField:
        id: instalment_input
        hint_text: "Monthly Instalment (KES)"
        input_filter: "float"
        font_size: "16sp"
        mode: "fill"
        fill_color: get_color("#2D2D2D")
        line_color_normal: get_color("#4D4D4D")
        line_color_focus: get_color("#2196F3")
        multiline: False
        size_hint_y: None
        height: "48dp"
        opacity: 0
        disabled: True
        on_text: root.calculate_apr_if_ready()

    BoxLayout:
        size_hint_y: None
        height: "40dp"
        spacing: "10dp"
        MDLabel:
            id: apr_label
            text: "APR: 0.00%"
            theme_text_color: "Secondary"
            font_style: "Caption"
        
        MDLabel:
            id: interest_label
            text: "Total Interest: KES 0.00"
            theme_text_color: "Secondary"
            font_style: "Caption"

    MDLabel:
        id: error_label
        text: ""
        theme_text_color: "Error"
        font_style: "Caption"
        size_hint_y: None
        height: "20dp"