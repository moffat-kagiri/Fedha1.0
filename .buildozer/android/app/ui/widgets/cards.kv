# ui/widgets/cards.kv
<RatioCard>:
    orientation: "vertical"
    size_hint: None, None
    size: "200dp", "120dp"
    padding: "16dp"
    spacing: "8dp"
    radius: "12dp"
    md_bg_color: root.bg_color
    
    MDIcon:
        icon: root.icon
        font_size: "24sp"
        halign: "center"
        theme_text_color: "Custom"
        text_color: root.text_color
        
    MDLabel:
        text: root.title
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: root.text_color
        
    MDLabel:
        text: f"{root.value:.1f}%"
        font_style: "H6"
        halign: "center"
        bold: True
        theme_text_color: "Custom"
        text_color: root.text_color

<TransactionCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: "80dp"
    padding: "16dp"
    spacing: "16dp"
    
    MDIcon:
        icon: root.icon
        font_size: "24sp"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color if root.category == "income" else app.theme_cls.error_color
        
    BoxLayout:
        orientation: "vertical"
        spacing: "4dp"
        
        MDLabel:
            text: root.description
            font_style: "Body1"
            shorten: True
            shorten_from: "right"
            
        MDLabel:
            text: root.date
            font_style: "Caption"
            theme_text_color: "Secondary"
            
    MDLabel:
        text: f"KES {root.amount:,.2f}"
        font_style: "Body1"
        halign: "right"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color if root.category == "income" else app.theme_cls.error_color