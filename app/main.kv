#:import get_color kivy.utils.get_color_from_hex

<NavigationIcon@MDIconButton>
    theme_text_color: "Custom"
    text_color: get_color("#FFFFFF")
    icon_size: "24sp"
    size_hint: None, None
    size: "48sp", "48sp"

<BottomNavigation@BoxLayout>:
    size_hint_y: None
    height: "56sp"
    spacing: "10sp"
    padding: "20sp", 0, "20sp", 0
    pos_hint: {"center_x": 0.5}
    canvas.before:
        Color:
            rgba: get_color("#1A1A1A")
        Rectangle:
            pos: self.pos
            size: self.size

    NavigationIcon:
        icon: "home"
        on_press: app.show_home_screen()
    
    NavigationIcon:
        icon: "chart-bar"
        on_press: app.show_summaries_screen()
    
    NavigationIcon:
        icon: "plus"
        on_press: app.show_add_screen()
    
    NavigationIcon:
        icon: "bank"
        on_press: app.show_loans()
    
    NavigationIcon:
        icon: "cloud-sync"
        on_press: app.sync_with_drive()

<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "10sp"
        spacing: "10sp"

        MDLabel:
            text: "Expense Tracker"
            halign: "center"
            font_style: "H5"
            theme_text_color: "Primary"
            size_hint_y: None
            height: self.texture_size[1]

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: "10sp"
            padding: "20sp", 0, "20sp", 0

            RatioButton:
                id: expenses_ratio_button
                text: "Expenses\\n0%"
                icon: "cash-minus"
            
            RatioButton:
                id: debt_ratio_button
                text: "Debt\\n0%"
                icon: "credit-card-clock"
            
            RatioButton:
                id: savings_ratio_button
                text: "Savings\\n0%"
                icon: "piggy-bank"

        BottomNavigation:

<RatioButton@MDRaisedButton>:
    text_size: self.size
    halign: "center"
    valign: "center"
    font_size: "16sp"
    line_height: 1.2
    size_hint_y: None
    height: "64sp"
    md_bg_color: get_color("#2D2D2D")
    radius: "8sp"
    icon: ""
    
    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: get_color("#FFFFFF")
        pos_hint: {"center_x": 0.2, "center_y": 0.5}
        font_size: "24sp"

<SummariesScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "10sp"
        spacing: "10sp"

        MDLabel:
            text: "Monthly Overview"
            halign: "center"
            font_style: "H5"
            size_hint_y: None
            height: self.texture_size[1]

        ScrollView:
            MDGridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: "10sp"
                padding: "20sp"

                SummaryButton:
                    id: income_button
                    icon: "cash-plus"
                    text: "Income\\nKES 0"
                
                SummaryButton:
                    id: expenses_button
                    icon: "cash-minus"
                    text: "Expenses\\nKES 0"
                
                SummaryButton:
                    id: savings_button
                    icon: "safe"
                    text: "Savings\\nKES 0"

        BottomNavigation:

<SummaryButton@MDRaisedButton>:
    text_size: self.size
    halign: "center"
    valign: "center"
    font_size: "16sp"
    line_height: 1.2
    size_hint: 1, None
    height: "80sp"
    md_bg_color: get_color("#2D2D2D")
    radius: "8sp"
    icon: ""
    
    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: get_color("#FFFFFF")
        pos_hint: {"center_x": 0.2, "center_y": 0.5}
        font_size: "32sp"

<InputScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "10sp"
        spacing: "10sp"

        GridLayout:
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: "10sp"
            padding: "20sp"

            InputButton:
                text: "Add Income"
                icon: "cash-plus"
                on_press: root.show_input_dialog('income')
            
            InputButton:
                text: "Add Expense"
                icon: "cash-minus"
                on_press: root.show_input_dialog('expense')
            
            InputButton:
                text: "Add Loan"
                icon: "bank-plus"
                on_press: root.show_input_dialog('loan')

        BottomNavigation:

<InputButton@MDRaisedButton>:
    size_hint_y: None
    height: "64sp"
    md_bg_color: get_color("#2D2D2D")
    radius: "8sp"
    icon: ""
    
    BoxLayout:
        orientation: "horizontal"
        padding: "20sp"
        spacing: "20sp"
        
        MDIcon:
            icon: root.icon
            theme_text_color: "Custom"
            text_color: get_color("#FFFFFF")
            font_size: "24sp"
        
        MDLabel:
            text: root.text
            font_style: "Button"
            theme_text_color: "Custom"
            text_color: get_color("#FFFFFF")
            halign: "left"

<LoansScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: "10sp"
        padding: "10sp"

        MDLabel:
            text: "Loan Management"
            font_style: "H5"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]

        ScrollView:
            MDGridLayout:
                id: loan_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: "10sp"
                padding: "10sp"

        BottomNavigation:

<LoanItem>:
    size_hint: 1, None
    height: "140sp"
    md_bg_color: get_color("#2D2D2D")
    radius: "12sp"
    padding: "16sp"
    spacing: "16sp"

    BoxLayout:
        orientation: "horizontal"
        spacing: "16sp"

        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.7
            spacing: "8sp"

            MDLabel:
                text: root.loan_data['Description']
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: get_color("#FFFFFF")
                shorten: True
                shorten_from: "right"
            
            MDLabel:
                text: f"KES {float(root.loan_data['Loan Amount']):,.2f}"
                theme_text_color: "Secondary"
                font_style: "Body2"
            
            MDLabel:
                text: f"{root.loan_data['Term']} months @ {root.loan_data['APR']}% APR"
                theme_text_color: "Secondary"
                font_style: "Caption"
            
            MDLabel:
                id: balance_label
                text: "Balance: KES 0.00"
                theme_text_color: "Error"
                font_style: "Body2"

        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.3
            spacing: "8sp"

            MDFlatButton:
                text: "PAYMENT"
                theme_text_color: "Custom"
                text_color: get_color("#4CAF50")
                font_size: "14sp"
                on_press: root.record_payment()
            
            MDFlatButton:
                text: "EDIT"
                theme_text_color: "Custom"
                text_color: get_color("#2196F3")
                font_size: "14sp"
                on_press: root.edit_loan()
            
            MDFlatButton:
                text: "DELETE"
                theme_text_color: "Custom"
                text_color: get_color("#F44336")
                font_size: "14sp"
                on_press: root.confirm_delete()

<InputDialogContent>:
    orientation: "vertical"
    spacing: "12sp"
    padding: "16sp"

    MDTextField:
        id: description_input
        hint_text: root.hint_text
        font_size: "16sp"
        mode: "rectangle"
        line_color_normal: get_color("#4D4D4D")

    MDTextField:
        id: amount_input
        hint_text: "Amount (KES)"
        input_filter: "float"
        font_size: "16sp"
        mode: "rectangle"
        line_color_normal: get_color("#4D4D4D")

    MDTextField:
        id: term_input
        hint_text: "Term (months)"
        input_filter: "int"
        font_size: "16sp"
        mode: "rectangle"
        line_color_normal: get_color("#4D4D4D")
        opacity: 0
        disabled: True

    MDTextField:
        id: instalment_input
        hint_text: "Monthly Instalment (KES)"
        input_filter: "float"
        font_size: "16sp"
        mode: "rectangle"
        line_color_normal: get_color("#4D4D4D")
        opacity: 0
        disabled: True

    MDLabel:
        text: "APR will be calculated automatically"
        theme_text_color: "Secondary"
        font_style: "Caption"
        size_hint_y: None
        height: self.texture_size[1]