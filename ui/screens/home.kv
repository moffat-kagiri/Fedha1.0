# ui/screens/home.kv
<RatioCard>:
    orientation: "vertical"
    size_hint: None, None
    size: "200dp", "120dp"
    padding: "16dp"
    spacing: "8dp"
    md_bg_color: app.theme_cls.primary_color if root.theme_color == "Primary" else app.theme_cls.accent_color
    radius: "12dp"
    
    MDIcon:
        icon: root.icon
        font_size: "24sp"
        halign: "center"
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 0.8) if root.theme_color == "Primary" else rgba(0, 0, 0, 0.8)
        
    MDLabel:
        text: root.title
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 0.8) if root.theme_color == "Primary" else rgba(0, 0, 0, 0.8)
        
    MDLabel:
        text: f"{root.value:.1f}%"
        font_style: "H6"
        halign: "center"
        bold: True
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 1) if root.theme_color == "Primary" else rgba(0, 0, 0, 1)

<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: "16dp"
        padding: "16dp"
        
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "16dp"
            
            MDIconButton:
                icon: "refresh"
                theme_text_color: "Custom"
                text_color: rgba(0, 0, 0, 0.8)
                on_release: root.update_overview()
                
            MDLabel:
                text: "Current Month Overview"
                font_style: "H6"
                bold: True
                halign: "left"
                
        ScrollView:
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: "16dp"
                padding: "8dp"
                
                # Quick Stats Card
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "120dp"
                    padding: "16dp"
                    spacing: "8dp"
                    radius: "12dp"
                    
                    MDLabel:
                        text: "Cash Flow"
                        font_style: "H6"
                        bold: True
                        
                    GridLayout:
                        cols: 2
                        spacing: "8dp"
                        
                        MDLabel:
                            text: "Income:"
                            font_style: "Body1"
                            
                        MDLabel:
                            id: income_label
                            text: "KES 0.00"
                            font_style: "Body1"
                            halign: "right"
                            
                        MDLabel:
                            text: "Expenses:"
                            font_style: "Body1"
                            
                        MDLabel:
                            id: expenses_label
                            text: "KES 0.00"
                            font_style: "Body1"
                            halign: "right"
                
                # Ratio Cards Grid
                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: "150dp"
                    spacing: "16dp"
                    
                    RatioCard:
                        id: expenses_card
                        title: "Expenses"
                        icon: "cash-minus"
                        theme_color: "Primary"
                        
                    RatioCard:
                        id: savings_card
                        title: "Savings"
                        icon: "piggy-bank"
                        theme_color: "Accent"
                        
                    RatioCard:
                        id: debt_card
                        title: "Debt"
                        icon: "credit-card-clock"
                        theme_color: "Accent"

        # Bottom Navigation
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "16dp"
            padding: "16dp", "8dp"
            md_bg_color: app.theme_cls.primary_color
            
            MDFloatLayout:
                MDRoundFlatButton:
                    text: "Add Transaction"
                    icon: "plus"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    on_release: app.root.current = 'input'