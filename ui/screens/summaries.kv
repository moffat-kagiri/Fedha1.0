# ui/screens/summaries.kv
<SummaryCard>:
    orientation: "vertical"
    size_hint: None, None
    size: "200dp", "120dp"
    padding: "16dp"
    spacing: "8dp"
    radius: "12dp"
    md_bg_color: app.theme_cls.primary_color
    
    MDIcon:
        icon: root.icon
        font_size: "24sp"
        halign: "center"
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 0.8)
        
    MDLabel:
        text: root.category
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 0.8)
        
    MDLabel:
        text: root.amount
        font_style: "H6"
        halign: "center"
        bold: True
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 1)
        
    MDLabel:
        text: f"{root.percentage:.1f}%"
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: rgba(255, 255, 255, 0.8)

<SummariesScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: "16dp"
        padding: "16dp"
        
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "16dp"
            
            MDIconButton:
                icon: "arrow-left"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.manager.current = 'home'
                
            MDLabel:
                text: "Financial Summary"
                font_style: "H6"
                bold: True
                halign: "left"
                
            MDIconButton:
                icon: "chart-areaspline"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.update_chart("line")
                
            MDIconButton:
                icon: "chart-bar"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.update_chart("bar")
        
        ScrollView:
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: "16dp"
                padding: "8dp"
                
                # Summary Cards
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: "140dp"
                    spacing: "16dp"
                    
                    SummaryCard:
                        id: income_card
                        category: "Income"
                        icon: "cash-plus"
                        
                    SummaryCard:
                        id: expenses_card
                        category: "Expenses"
                        icon: "cash-minus"
                        md_bg_color: app.theme_cls.error_color
                        
                    SummaryCard:
                        id: savings_card
                        category: "Savings"
                        icon: "piggy-bank"
                        md_bg_color: app.theme_cls.accent_color
                
                # Chart Container
                BoxLayout:
                    id: chart_container
                    size_hint_y: None
                    height: "300dp"
                    padding: "8dp"
                
                # Transaction Categories
                GridLayout:
                    cols: 3
                    size_hint_y: None
                    height: "100dp"
                    spacing: "16dp"
                    padding: "8dp"
                    
                    MDRaisedButton:
                        text: "Income Details"
                        icon: "cash-multiple"
                        on_release: root.show_detailed_statement("income")
                        
                    MDRaisedButton:
                        text: "Expenses Details"
                        icon: "cash-remove"
                        on_release: root.show_detailed_statement("expenses")
                        
                    MDRaisedButton:
                        text: "Savings Details"
                        icon: "safe"
                        on_release: root.show_detailed_statement("savings")