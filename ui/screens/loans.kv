# ui/screens/loans.kv
<LoanItem>:
    orientation: "vertical"
    size_hint: 1, None
    height: "160dp"
    padding: "16dp"
    spacing: "8dp"
    md_bg_color: app.theme_cls.bg_dark
    radius: "12dp"
    
    BoxLayout:
        orientation: "horizontal"
        spacing: "16dp"
        
        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.7
            spacing: "4dp"
            
            MDLabel:
                text: root.loan_data['Description']
                font_style: "H6"
                theme_text_color: "Primary"
                shorten: True
                shorten_from: "right"
                
            MDLabel:
                text: f"KES {root.loan_data['Loan Amount']:,.2f}"
                font_style: "Body2"
                theme_text_color: "Secondary"
                
            MDLabel:
                text: f"{root.loan_data['Term']} months @ {root.loan_data['APR']:.2f}% APR"
                font_style: "Caption"
                theme_text_color: "Secondary"
                
            MDLabel:
                id: balance_label
                text: "Balance: KES 0.00"
                font_style: "Body1"
                theme_text_color: "Error"
                
        BoxLayout:
            orientation: "vertical"
            size_hint_x: 0.3
            spacing: "8dp"
            
            MDTextField:
                id: payment_input
                hint_text: "Payment Amount"
                input_filter: "float"
                font_size: "14sp"
                size_hint_y: None
                height: "48dp"
                
            MDRaisedButton:
                text: "RECORD PAYMENT"
                size_hint_y: None
                height: "48dp"
                on_release: root.record_payment()
                
            MDIconButton:
                icon: "history"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.show_payment_history()

<LoansScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: "16dp"
        padding: "16dp"
        
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            spacing: "16dp"
            
            MDIconButton:
                icon: "arrow-left"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.manager.current = 'home'
                
            MDLabel:
                text: "Loan Management"
                font_style: "H6"
                bold: True
                halign: "left"
                
            MDIconButton:
                id: sort_button
                icon: "sort"
                theme_text_color: "Custom"
                text_color: app.theme_cls.primary_color
                on_release: root.show_sort_menu()
        
        ScrollView:
            GridLayout:
                id: loan_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: "16dp"
                padding: "8dp"