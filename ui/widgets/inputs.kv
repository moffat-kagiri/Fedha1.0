# ui/widgets/inputs.kv
<CurrencyInput>:
    hint_text: f"Amount ({root.currency_symbol})"
    input_filter: "float"
    mode: "fill"
    font_size: "16sp"
    prefix: root.currency_symbol
    helper_text: f"Minimum: {root.currency_symbol} {root.min_value}"
    helper_text_mode: "on_error"
    
<DateInput>:
    orientation: "horizontal"
    spacing: "8dp"
    
    MDIconButton:
        icon: "calendar"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color
        on_release: root.show_date_picker()
        
    MDLabel:
        text: root.selected_date if root.selected_date else "Select Date"
        font_style: "Body1"
        theme_text_color: "Primary"

<LoanInputGroup>:
    orientation: "vertical"
    spacing: "8dp"
    
    MDTextField:
        id: principal_input
        hint_text: "Loan Amount (KES)"
        input_filter: "float"
        
    MDTextField:
        id: instalment_input
        hint_text: "Monthly Instalment (KES)"
        input_filter: "float"
        
    MDTextField:
        id: term_input
        hint_text: "Term (months)"
        input_filter: "int"
        
    MDLabel:
        text: f"APR: {root.apr}% | Total Interest: KES {root.total_interest}"
        theme_text_color: "Secondary"
        opacity: 1 if root.show_apr else 0

<CategorySelect>:
    orientation: "horizontal"
    spacing: "16dp"
    
    MDIconButton:
        icon: "cash-plus"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color if root.selected_category == "income" else [0.5, 0.5, 0.5, 1]
        on_release: root.select_category("income")
        
    MDIconButton:
        icon: "cash-minus"
        theme_text_color: "Custom"
        text_color: app.theme_cls.error_color if root.selected_category == "expense" else [0.5, 0.5, 0.5, 1]
        on_release: root.select_category("expense")
        
    MDIconButton:
        icon: "bank"
        theme_text_color: "Custom"
        text_color: app.theme_cls.accent_color if root.selected_category == "loan" else [0.5, 0.5, 0.5, 1]
        on_release: root.select_category("loan"

<InputContent>:
    orientation: 'vertical'
    Label:
        text: root.hint_text
    TextInput:
        id: input